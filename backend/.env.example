# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/luxury_booking_db
DB_ECHO=False

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
DEBUG=False
APP_NAME=Luxury Booking Platform API
APP_VERSION=1.0.0

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Payment Integration (Stubs for now)
PAYPAL_API_KEY=your_paypal_api_key
PAYPAL_SECRET=your_paypal_secret

# Rwanda MoMo Configuration
MOMO_API_KEY=your_momo_api_key
MOMO_BEARER_TOKEN=your_momo_bearer_token
